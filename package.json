{
  "name": "blue-genji",
  "type": "module",
  "version": "1.2.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "sh start.sh",
    "lint": "next lint --dir app --dir components --dir lib --dir tests",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:ts5": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "sonar": "node scripts/sonar-scan.mjs",
    "e2e:install": "playwright install chromium",
    "pretest:e2e": "npm run e2e:install",
    "test:e2e": "playwright test",
    "pretest:e2e:ui": "npm run e2e:install",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "seed": "tsx lib/server/seed/main.ts",
    "seed:view": "tsx lib/server/seed-view.ts",
    "backfill:avatars": "tsx lib/server/backfill-avatars.ts",
    "replay:deletions": "tsx lib/server/replay-account-deletions.ts",
    "rotate:hidden-avatars": "tsx lib/server/rotate-hidden-avatars.ts",
    "push:keys": "tsx lib/server/generate-vapid-keys.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.522.0",
    "mysql2": "^3.14.1",
    "next": "^15.5.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.13",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sprintf-js": "^1.1.3",
    "test-exclude": "^8.0.0",
    "uri-js": "npm:uri-js-replace@^1.0.1"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "unrs-resolver": false
  }
}
