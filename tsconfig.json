{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "outDir": "dist",
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Défaut de TypeScript 6+ : un import pour effet de bord doit résoudre un
    // module typé. Next ne déclare que les `*.module.css`, si bien que les
    // feuilles globales (`import "./globals.css"`) seraient refusées. Posé
    // explicitement pour que TS 5 (build, Jest, ESLint) et TS 7 (typecheck)
    // lisent la même règle.
    "noUncheckedSideEffectImports": false,
    "jsx": "preserve",
    "incremental": true,
    "types": ["jest", "node"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "tests"]
}
