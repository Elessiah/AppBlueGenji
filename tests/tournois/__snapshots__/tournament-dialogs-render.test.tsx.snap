form></div></div>"`;

exports[`AdvanceTournamentDialog — rendu inchangé ouverture d'un tournoi masqué 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="advance-tournament-title" aria-describedby="advance-tournament-summary" tabindex="-1" style="width:100%;max-width:480px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, #2a3340);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="advance-tournament-title" style="margin:0;font-size:18px">Ouvrir les inscriptions maintenant</h3><p id="advance-tournament-summary" style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">Les inscriptions ouvrent à cet instant, au lieu du <strong style="color:var(--ink)">«2026-05-06T10:00:00.000Z»</strong>. Leur clôture et le coup d&#x27;envoi restent prévus aux dates annoncées.</p><dl style="margin:16px 0 0;display:grid;grid-template-columns:auto minmax(0, 1fr);gap:8px 16px;font-size:13px;align-items:baseline"><dt style="color:var(--text-2, #9aa4b2)">Étape</dt><dd style="margin:0;font-weight:600;text-align:right;overflow-wrap:anywhere">Masqué › Inscriptions</dd></dl><p style="margin-top:14px;font-size:13px;line-height:1.55;color:var(--text-2, #9aa4b2)">Ce tournoi n&#x27;était pas encore publié : ouvrir ses inscriptions le rend visible de tous.</p><form><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" style="padding:8px 20px;font-size:13px">Ouvrir les inscriptions</button></div></form></div></div>"`;

