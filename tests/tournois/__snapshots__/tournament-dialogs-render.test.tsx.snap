// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`AdvanceTournamentDialog — rendu inchangé clôture des inscriptions 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="advance-tournament-title" aria-describedby="advance-tournament-summary" tabindex="-1" style="width:100%;max-width:480px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, #2a3340);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="advance-tournament-title" style="margin:0;font-size:18px">Clore les inscriptions maintenant</h3><p id="advance-tournament-summary" style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">Les inscriptions ferment à cet instant, au lieu du <strong style="color:var(--ink)">«2026-05-10T10:00:00.000Z»</strong>: personne ne pourra plus rejoindre le tournoi. Le coup d&#x27;envoi reste prévu le <strong style="color:var(--ink)">«2026-05-12T10:00:00.000Z»</strong>.</p><dl style="margin:16px 0 0;display:grid;grid-template-columns:auto minmax(0, 1fr);gap:8px 16px;font-size:13px;align-items:baseline"><dt style="color:var(--text-2, #9aa4b2)">Étape</dt><dd style="margin:0;font-weight:600;text-align:right;overflow-wrap:anywhere">Inscriptions › Clôture</dd><dt style="color:var(--text-2, #9aa4b2)">Effectif final</dt><dd class="num" style="margin:0;font-weight:600;text-align:right">4</dd></dl><form><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" style="padding:8px 20px;font-size:13px">Clore les inscriptions</button></div></form></div></div>"`;

exports[`AdvanceTournamentDialog — rendu inchangé coup d'envoi 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="advance-tournament-title" aria-describedby="advance-tournament-summary" tabindex="-1" style="width:100%;max-width:480px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, #2a3340);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="advance-tournament-title" style="margin:0;font-size:18px">Lancer le tournoi maintenant</h3><p id="advance-tournament-summary" style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">Le coup d&#x27;envoi est avancé à cet instant, au lieu du <strong style="color:var(--ink)">«2026-05-12T10:00:00.000Z»</strong>. Le tirage est fait sur les engagés du moment : personne ne pourra plus rejoindre le tournoi.</p><dl style="margin:16px 0 0;display:grid;grid-template-columns:auto minmax(0, 1fr);gap:8px 16px;font-size:13px;align-items:baseline"><dt style="color:var(--text-2, #9aa4b2)">Étape</dt><dd style="margin:0;font-weight:600;text-align:right;overflow-wrap:anywhere">Clôture › En cours</dd><dt style="color:var(--text-2, #9aa4b2)">Équipes au départ</dt><dd class="num" style="margin:0;font-weight:600;text-align:right">6</dd></dl><form><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" style="padding:8px 20px;font-size:13px">Lancer maintenant</button></div></form></div></div>"`;

exports[`AdvanceTournamentDialog — rendu inchangé coup d'envoi sans engagé, en solo 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="advance-tournament-title" aria-describedby="advance-tournament-summary" tabindex="-1" style="width:100%;max-width:480px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, #2a3340);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="advance-tournament-title" style="margin:0;font-size:18px">Lancer le tournoi maintenant</h3><p id="advance-tournament-summary" style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">Le coup d&#x27;envoi est avancé à cet instant, au lieu du <strong style="color:var(--ink)">«2026-05-12T10:00:00.000Z»</strong>. Le tirage est fait sur les engagés du moment : personne ne pourra plus rejoindre le tournoi.</p><dl style="margin:16px 0 0;display:grid;grid-template-columns:auto minmax(0, 1fr);gap:8px 16px;font-size:13px;align-items:baseline"><dt style="color:var(--text-2, #9aa4b2)">Étape</dt><dd style="margin:0;font-weight:600;text-align:right;overflow-wrap:anywhere">Clôture › En cours</dd><dt style="color:var(--text-2, #9aa4b2)">Joueur au départ</dt><dd class="num" style="margin:0;font-weight:600;text-align:right">0</dd></dl><p role="note" style="margin-top:14px;font-size:13px;line-height:1.55;color:var(--red-live, #ff4d4d)">Moins de deux engagés : le tournoi ne jouera aucun match et sera clos aussitôt.</p><form><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" style="padding:8px 20px;font-size:13px">Clore le tournoi</button></div></form></div></div>"`;

exports[`AdvanceTournamentDialog — rendu inchangé coup d'envoi à un engagé 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="advance-tournament-title" aria-describedby="advance-tournament-summary" tabindex="-1" style="width:100%;max-width:480px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, #2a3340);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="advance-tournament-title" style="margin:0;font-size:18px">Lancer le tournoi maintenant</h3><p id="advance-tournament-summary" style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">Le coup d&#x27;envoi est avancé à cet instant, au lieu du <strong style="color:var(--ink)">«2026-05-12T10:00:00.000Z»</strong>. Le tirage est fait sur les engagés du moment : personne ne pourra plus rejoindre le tournoi.</p><dl style="margin:16px 0 0;display:grid;grid-template-columns:auto minmax(0, 1fr);gap:8px 16px;font-size:13px;align-items:baseline"><dt style="color:var(--text-2, #9aa4b2)">Étape</dt><dd style="margin:0;font-weight:600;text-align:right;overflow-wrap:anywhere">Clôture › En cours</dd><dt style="color:var(--text-2, #9aa4b2)">Équipe au départ</dt><dd class="num" style="margin:0;font-weight:600;text-align:right">1</dd></dl><p role="note" style="margin-top:14px;font-size:13px;line-height:1.55;color:var(--red-live, #ff4d4d)">Moins de deux engagés : le tournoi ne jouera aucun match et sera clos aussitôt, l&#x27;unique engagé étant déclaré premier.</p><form><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" style="padding:8px 20px;font-size:13px">Clore le tournoi</button></div></form></div></div>"`;

exports[`AdvanceTournamentDialog — rendu inchangé ouverture d'un tournoi masqué 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="advance-tournament-title" aria-describedby="advance-tournament-summary" tabindex="-1" style="width:100%;max-width:480px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, #2a3340);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="advance-tournament-title" style="margin:0;font-size:18px">Ouvrir les inscriptions maintenant</h3><p id="advance-tournament-summary" style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">Les inscriptions ouvrent à cet instant, au lieu du <strong style="color:var(--ink)">«2026-05-06T10:00:00.000Z»</strong>. Leur clôture et le coup d&#x27;envoi restent prévus aux dates annoncées.</p><dl style="margin:16px 0 0;display:grid;grid-template-columns:auto minmax(0, 1fr);gap:8px 16px;font-size:13px;align-items:baseline"><dt style="color:var(--text-2, #9aa4b2)">Étape</dt><dd style="margin:0;font-weight:600;text-align:right;overflow-wrap:anywhere">Masqué › Inscriptions</dd></dl><p style="margin-top:14px;font-size:13px;line-height:1.55;color:var(--text-2, #9aa4b2)">Ce tournoi n&#x27;était pas encore publié : ouvrir ses inscriptions le rend visible de tous.</p><form><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" style="padding:8px 20px;font-size:13px">Ouvrir les inscriptions</button></div></form></div></div>"`;

exports[`AdvanceTournamentDialog — rendu inchangé ouverture des inscriptions 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="advance-tournament-title" aria-describedby="advance-tournament-summary" tabindex="-1" style="width:100%;max-width:480px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, #2a3340);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="advance-tournament-title" style="margin:0;font-size:18px">Ouvrir les inscriptions maintenant</h3><p id="advance-tournament-summary" style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">Les inscriptions ouvrent à cet instant, au lieu du <strong style="color:var(--ink)">«2026-05-06T10:00:00.000Z»</strong>. Leur clôture et le coup d&#x27;envoi restent prévus aux dates annoncées.</p><dl style="margin:16px 0 0;display:grid;grid-template-columns:auto minmax(0, 1fr);gap:8px 16px;font-size:13px;align-items:baseline"><dt style="color:var(--text-2, #9aa4b2)">Étape</dt><dd style="margin:0;font-weight:600;text-align:right;overflow-wrap:anywhere">Annoncé › Inscriptions</dd></dl><form><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" style="padding:8px 20px;font-size:13px">Ouvrir les inscriptions</button></div></form></div></div>"`;

exports[`DeleteTournamentDialog — rendu inchangé demande le nom du tournoi 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="delete-tournament-title" tabindex="-1" style="width:100%;max-width:480px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--red-live, #ff4d4d);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="delete-tournament-title" style="margin:0;font-size:18px;color:var(--red-live, #ff4d4d)">Supprimer définitivement ce tournoi</h3><p style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">Cette action est irréversible. Le tournoi <strong style="color:var(--ink)">Coupe d&#x27;hiver</strong> disparaîtra du site avec tous ses matchs, ses inscriptions et ses classements — y compris des palmarès et des statistiques de ses participants.</p><p style="margin-top:8px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">Aucune équipe ni aucun joueur n&#x27;est supprimé : seuls les résultats de ce tournoi le sont.</p><form><div class="field" style="margin-top:18px"><label for="delete-tournament-confirmation">Recopie le nom du tournoi pour confirmer</label><input id="delete-tournament-confirmation" placeholder="Coupe d&#x27;hiver" autoComplete="off" aria-describedby="delete-tournament-hint" value=""/><p id="delete-tournament-hint" aria-live="polite" style="margin-top:6px;font-size:12px;color:var(--ink-dim, #6b7480)">La suppression restera bloquée tant que le nom ne correspond pas.</p></div><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" disabled="" style="padding:8px 20px;font-size:13px;border-color:var(--red-live, #ff4d4d)">Supprimer définitivement</button></div></form></div></div>"`;

exports[`EndurancePenaltyDialog — rendu inchangé avant la première manche 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:80;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="endurance-penalty-title" tabindex="-1" style="width:100%;max-width:480px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, var(--line-soft));border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><form><h3 id="endurance-penalty-title" style="margin:0;font-size:18px;color:var(--ink)">Pénalité d&#x27;endurance</h3><p style="margin-top:6px;font-size:13px;color:var(--text-2, #9aa4b2)">Frost Alliance · 6 points · avant la première manche</p><div class="field" style="margin-top:18px"><label for="endurance-penalty-points">Points retirés</label><input id="endurance-penalty-points" type="number" inputMode="numeric" min="1" max="99" step="1" aria-invalid="false" aria-describedby="endurance-penalty-hint" style="width:120px;font-size:13px" value="1"/></div><div class="field" style="margin-top:14px"><label for="endurance-penalty-reason">Motif</label><textarea id="endurance-penalty-reason" rows="3" maxLength="200" aria-invalid="false" aria-describedby="endurance-penalty-hint" placeholder="Retard au coup d&#x27;envoi, joueur non éligible aligné…" style="width:100%;resize:vertical;font-size:13px"></textarea><p id="endurance-penalty-hint" aria-live="polite" style="margin:6px 0 0;font-size:12px;color:rgba(255,74,92,0.95)">Indiquez le motif de la pénalité.</p></div><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" disabled="" style="padding:8px 20px;font-size:13px">Appliquer la pénalité</button></div></form></div></div>"`;

exports[`EndurancePenaltyDialog — rendu inchangé en cours de qualification 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:80;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="endurance-penalty-title" tabindex="-1" style="width:100%;max-width:480px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, var(--line-soft));border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><form><h3 id="endurance-penalty-title" style="margin:0;font-size:18px;color:var(--ink)">Pénalité d&#x27;endurance</h3><p style="margin-top:6px;font-size:13px;color:var(--text-2, #9aa4b2)">Frost Alliance · 6 points · manche 3</p><div class="field" style="margin-top:18px"><label for="endurance-penalty-points">Points retirés</label><input id="endurance-penalty-points" type="number" inputMode="numeric" min="1" max="99" step="1" aria-invalid="false" aria-describedby="endurance-penalty-hint" style="width:120px;font-size:13px" value="1"/></div><div class="field" style="margin-top:14px"><label for="endurance-penalty-reason">Motif</label><textarea id="endurance-penalty-reason" rows="3" maxLength="200" aria-invalid="false" aria-describedby="endurance-penalty-hint" placeholder="Retard au coup d&#x27;envoi, joueur non éligible aligné…" style="width:100%;resize:vertical;font-size:13px"></textarea><p id="endurance-penalty-hint" aria-live="polite" style="margin:6px 0 0;font-size:12px;color:rgba(255,74,92,0.95)">Indiquez le motif de la pénalité.</p></div><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" disabled="" style="padding:8px 20px;font-size:13px">Appliquer la pénalité</button></div></form></div></div>"`;

exports[`IssueReportDialog — rendu inchangé tout le tournoi 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:80;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="issue-report-title" tabindex="-1" style="width:100%;max-width:500px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, var(--line-soft));border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><form><h3 id="issue-report-title" style="margin:0;font-size:18px;color:var(--ink)">Signaler un problème</h3><p style="margin-top:6px;font-size:13px;color:var(--text-2, #9aa4b2)">Portée : tournoi entier</p><div class="field" style="margin-top:18px"><label for="issue-report-message">Que se passe-t-il ?</label><textarea id="issue-report-message" rows="5" maxLength="1000" aria-invalid="false" aria-describedby="issue-report-hint" placeholder="Adversaire absent, score contesté, problème de serveur…" style="width:100%;resize:vertical;font-size:13px"></textarea><p id="issue-report-hint" style="margin:6px 0 0;font-size:12px;color:var(--text-2, #9aa4b2)">0/1000 — envoyé aux arbitres sur Discord.</p></div><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" disabled="" style="padding:8px 20px;font-size:13px">Envoyer au staff</button></div></form></div></div>"`;

exports[`IssueReportDialog — rendu inchangé une manche 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:80;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="issue-report-title" tabindex="-1" style="width:100%;max-width:500px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, var(--line-soft));border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><form><h3 id="issue-report-title" style="margin:0;font-size:18px;color:var(--ink)">Signaler un problème</h3><p style="margin-top:6px;font-size:13px;color:var(--text-2, #9aa4b2)">Match : Frost Alliance vs Nova</p><div class="field" style="margin-top:18px"><label for="issue-report-message">Que se passe-t-il ?</label><textarea id="issue-report-message" rows="5" maxLength="1000" aria-invalid="false" aria-describedby="issue-report-hint" placeholder="Adversaire absent, score contesté, problème de serveur…" style="width:100%;resize:vertical;font-size:13px"></textarea><p id="issue-report-hint" style="margin:6px 0 0;font-size:12px;color:var(--text-2, #9aa4b2)">0/1000 — envoyé aux arbitres sur Discord.</p></div><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" disabled="" style="padding:8px 20px;font-size:13px">Envoyer au staff</button></div></form></div></div>"`;

exports[`MatchLiveDialog — rendu inchangé diffusée en direct 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:80;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="match-live-title" tabindex="-1" style="width:100%;max-width:460px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, var(--line-soft));border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><form><h3 id="match-live-title" style="margin:0;font-size:18px;color:var(--ink)">Diffusion du match</h3><p style="margin-top:6px;font-size:13px;color:var(--text-2, #9aa4b2)">Frost Alliance vs Nova</p><label style="display:flex;align-items:center;gap:10px;margin:18px 0;font-size:14px;color:var(--text-0, #e6ebf2);cursor:pointer"><input type="checkbox" checked=""/>Ce match est casté</label><fieldset style="border:none;padding:0;margin:0 0 16px"><legend style="font-size:12px;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-2, #9aa4b2);padding:0;margin-bottom:8px">Passage à l&#x27;antenne</legend><label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-1, #c3ccd8);margin-bottom:6px;cursor:pointer"><input type="radio" name="match-live-trigger" value="AUTO"/>Automatique au démarrage du match</label><label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-2, #9aa4b2);margin-bottom:6px;cursor:not-allowed"><input type="radio" name="match-live-trigger" disabled="" value="START_TIME"/>À la date de début du match</label><label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--text-1, #c3ccd8);margin-bottom:6px;cursor:pointer"><input type="radio" name="match-live-trigger" checked="" value="MANUAL"/>Manuel (bouton d&#x27;antenne)</label><p style="margin:4px 0 0;font-size:12px;color:var(--text-2, #9aa4b2)">Aucune date de début n&#x27;est fixée sur ce match : l&#x27;antenne à l&#x27;heure dite demande d&#x27;abord un horaire.</p></fieldset><div class="field"><label for="match-live-url">Chaîne du match (facultatif)</label><input id="match-live-url" maxLength="255" placeholder="https://twitch.tv/…" aria-invalid="false" aria-describedby="match-live-url-hint" value="https://twitch.tv/bluegenji"/><p id="match-live-url-hint" style="margin:6px 0 0;font-size:12px;color:var(--text-2, #9aa4b2)">Laisser vide pour signaler le match sans lien. Plateformes acceptées : twitch.tv, youtube.com, youtu.be, kick.com.</p></div><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" style="padding:8px 20px;font-size:13px">Enregistrer</button></div></form></div></div>"`;

exports[`MatchLiveDialog — rendu inchangé sans diffusion 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:80;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="match-live-title" tabindex="-1" style="width:100%;max-width:460px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, var(--line-soft));border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><form><h3 id="match-live-title" style="margin:0;font-size:18px;color:var(--ink)">Diffusion du match</h3><p style="margin-top:6px;font-size:13px;color:var(--text-2, #9aa4b2)">Frost Alliance vs Nova</p><label style="display:flex;align-items:center;gap:10px;margin:18px 0;font-size:14px;color:var(--text-0, #e6ebf2);cursor:pointer"><input type="checkbox"/>Ce match est casté</label><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" style="padding:8px 20px;font-size:13px">Enregistrer</button></div></form></div></div>"`;

exports[`RemoveEntrantDialog — rendu inchangé inscriptions closes 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="remove-entrant-title" aria-describedby="remove-entrant-summary" tabindex="-1" style="width:100%;max-width:440px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, #2a3340);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="remove-entrant-title" style="margin:0;font-size:18px">Retirer Frost Alliance du tournoi</h3><p id="remove-entrant-summary" style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">L&#x27;inscription est <strong style="color:var(--ink)">effacée</strong> : rien n&#x27;indiquera que cet engagé a pris part au tournoi, à la différence d&#x27;un abandon. La place est rendue au plateau.</p><p role="note" style="margin-top:12px;font-size:13px;line-height:1.55;color:var(--amber)">Les inscriptions sont closes : plus personne ne peut prendre cette place, et cet engagé ne pourra pas être réinscrit sans rouvrir les inscriptions.</p><form><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" style="padding:8px 20px;font-size:13px">Retirer</button></div></form></div></div>"`;

exports[`RemoveEntrantDialog — rendu inchangé inscriptions ouvertes 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="remove-entrant-title" aria-describedby="remove-entrant-summary" tabindex="-1" style="width:100%;max-width:440px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--line-strong-cy, #2a3340);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="remove-entrant-title" style="margin:0;font-size:18px">Retirer Frost Alliance du tournoi</h3><p id="remove-entrant-summary" style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">L&#x27;inscription est <strong style="color:var(--ink)">effacée</strong> : rien n&#x27;indiquera que cet engagé a pris part au tournoi, à la différence d&#x27;un abandon. La place est rendue au plateau.</p><p style="margin-top:12px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">Les inscriptions sont ouvertes : la place libérée peut être reprise, et cet engagé réinscrit.</p><form><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" style="padding:8px 20px;font-size:13px">Retirer</button></div></form></div></div>"`;

exports[`RollbackRoundDialog — rendu inchangé tournoi en cours 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="rollback-round-title" tabindex="-1" style="width:100%;max-width:520px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--red-live, #ff4d4d);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="rollback-round-title" style="margin:0;font-size:18px;color:var(--red-live, #ff4d4d)">Effacer la manche 2</h3><p style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55"><strong style="color:var(--ink)">la manche 2</strong> perd tout ce qui y a été saisi : scores, vainqueurs, forfaits de match et reports en attente. Les rencontres restent en place, avec les mêmes équipes, et redeviennent à jouer.</p><p style="margin-top:8px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">C&#x27;est ce qui rouvre la manche précédente à la correction. Le geste se répète : chaque fois, le tournoi recule d&#x27;une manche. Les abandons et les pénalités déjà déclarés, eux, restent en vigueur.</p><div role="note" style="margin-top:14px;padding:10px 12px;border-radius:var(--r-cy-sm, 8px);border:1px solid color-mix(in srgb, var(--amber) 45%, transparent);background:color-mix(in srgb, var(--amber) 8%, transparent);font-size:12.5px;line-height:1.5;color:var(--ink, #e7ecf3)">⚠️ <strong>Note les scores ci-dessous avant de continuer.</strong> Rien n&#x27;est archivé : une fois la manche effacée, il faudra les ressaisir à la main pour revenir à l&#x27;état actuel.</div><div class="scroll-area scroll-subtle" tabindex="0" role="region" aria-label="Scores qui vont être effacés" style="overflow-y:auto;overflow-x:visible;max-height:220px;margin-top:12px"><ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px"><li style="display:flex;justify-content:space-between;gap:12px;font-size:12.5px;padding:6px 10px;border-radius:var(--r-cy-sm, 8px);background:var(--cyber-bg-3, #1b2029)"><span style="color:var(--text-2, #9aa4b2)">Frost Alliance vs Nova</span><span class="mono" style="color:var(--ink, #e7ecf3);white-space:nowrap">2 – 1</span></li><li style="display:flex;justify-content:space-between;gap:12px;font-size:12.5px;padding:6px 10px;border-radius:var(--r-cy-sm, 8px);background:var(--cyber-bg-3, #1b2029)"><span style="color:var(--text-2, #9aa4b2)">Kairos vs Zenith</span><span class="mono" style="color:var(--ink, #e7ecf3);white-space:nowrap">aucun score saisi</span></li></ul></div><form><label style="display:flex;align-items:flex-start;gap:8px;margin-top:16px;font-size:13px;line-height:1.5;color:var(--text-2, #9aa4b2);cursor:pointer"><input type="checkbox" style="margin-top:2px"/>J&#x27;ai noté les scores ci-dessus.</label><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" disabled="" style="padding:8px 20px;font-size:13px;border-color:var(--red-live, #ff4d4d)">Effacer et reculer</button></div></form></div></div>"`;

exports[`RollbackRoundDialog — rendu inchangé tournoi terminé 1`] = `"<div role="presentation" style="position:fixed;inset:0;z-index:90;background:rgba(6, 8, 12, 0.72);display:flex;align-items:center;justify-content:center;padding:16px"><div role="dialog" aria-modal="true" class="dialog-bounded" aria-labelledby="rollback-round-title" tabindex="-1" style="width:100%;max-width:520px;background:var(--cyber-bg-2, #14181f);border:1px solid var(--red-live, #ff4d4d);border-radius:var(--r-cy-md, 12px);box-shadow:0 24px 64px rgba(0,0,0,0.6);padding:22px"><h3 id="rollback-round-title" style="margin:0;font-size:18px;color:var(--red-live, #ff4d4d)">Effacer la manche 2</h3><p style="margin-top:10px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55"><strong style="color:var(--ink)">la manche 2</strong> perd tout ce qui y a été saisi : scores, vainqueurs, forfaits de match et reports en attente. Les rencontres restent en place, avec les mêmes équipes, et redeviennent à jouer.</p><p style="margin-top:8px;font-size:13px;color:var(--text-2, #9aa4b2);line-height:1.55">C&#x27;est ce qui rouvre la manche précédente à la correction. Le geste se répète : chaque fois, le tournoi recule d&#x27;une manche. Les abandons et les pénalités déjà déclarés, eux, restent en vigueur.</p><div role="note" style="margin-top:14px;padding:10px 12px;border-radius:var(--r-cy-sm, 8px);border:1px solid color-mix(in srgb, var(--red-live, #ff4d4d) 45%, transparent);background:color-mix(in srgb, var(--red-live, #ff4d4d) 8%, transparent);font-size:12.5px;line-height:1.5;color:var(--ink, #e7ecf3)">🏁 <strong>Ce tournoi est terminé : il va être rouvert.</strong> Son classement final est effacé et il repasse « en cours ». Une nouvelle championne sera proclamée — et réannoncée sur Discord — dès que cette manche aura été rejouée.</div><div role="note" style="margin-top:14px;padding:10px 12px;border-radius:var(--r-cy-sm, 8px);border:1px solid color-mix(in srgb, var(--amber) 45%, transparent);background:color-mix(in srgb, var(--amber) 8%, transparent);font-size:12.5px;line-height:1.5;color:var(--ink, #e7ecf3)">⚠️ <strong>Note les scores ci-dessous avant de continuer.</strong> Rien n&#x27;est archivé : une fois la manche effacée, il faudra les ressaisir à la main pour revenir à l&#x27;état actuel.</div><div class="scroll-area scroll-subtle" tabindex="0" role="region" aria-label="Scores qui vont être effacés" style="overflow-y:auto;overflow-x:visible;max-height:220px;margin-top:12px"><ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px"><li style="display:flex;justify-content:space-between;gap:12px;font-size:12.5px;padding:6px 10px;border-radius:var(--r-cy-sm, 8px);background:var(--cyber-bg-3, #1b2029)"><span style="color:var(--text-2, #9aa4b2)">Frost Alliance vs Nova</span><span class="mono" style="color:var(--ink, #e7ecf3);white-space:nowrap">2 – 1</span></li><li style="display:flex;justify-content:space-between;gap:12px;font-size:12.5px;padding:6px 10px;border-radius:var(--r-cy-sm, 8px);background:var(--cyber-bg-3, #1b2029)"><span style="color:var(--text-2, #9aa4b2)">Kairos vs Zenith</span><span class="mono" style="color:var(--ink, #e7ecf3);white-space:nowrap">aucun score saisi</span></li></ul></div><form><label style="display:flex;align-items:flex-start;gap:8px;margin-top:16px;font-size:13px;line-height:1.5;color:var(--text-2, #9aa4b2);cursor:pointer"><input type="checkbox" style="margin-top:2px"/>J&#x27;ai noté les scores ci-dessus.</label><div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button type="button" class="btn ghost" style="padding:8px 18px;font-size:13px">Annuler</button><button type="submit" class="btn" disabled="" style="padding:8px 20px;font-size:13px;border-color:var(--red-live, #ff4d4d)">Effacer et reculer</button></div></form></div></div>"`;
