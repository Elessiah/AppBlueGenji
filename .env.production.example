# ------------------------------------------------------------------
# BlueGenji Esport — .env de PRODUCTION (modèle)
# ------------------------------------------------------------------
# Copier vers .env.production (ou .env sur l'hôte) puis remplir.
# Ne JAMAIS committer le vrai fichier avec des secrets.
# ------------------------------------------------------------------

# Mode Next.js — DOIT être "production" pour activer le flag `secure` sur les
# cookies de session/OAuth. Le bypass DEV_AUTH_USER_ID, lui, est en liste
# blanche : il n'est actif que si NODE_ENV vaut exactement "development", donc
# il reste désactivé ici même si cette variable venait à manquer.
NODE_ENV=production

# ------------------------------------------------------------------
# URL publique de l'application
# ------------------------------------------------------------------
# OBLIGATOIRE en prod. Sert de base à toutes les redirections OAuth
# (start + callback). Sans cette variable, Next.js retombe sur l'hôte
# interne vu par le serveur (ex: http://localhost:3000) et redirige
# le navigateur vers localhost après la callback Google.
#
# Doit correspondre EXACTEMENT au domaine public servi par le reverse-proxy,
# sans slash final.
APP_URL=https://bluegenji-esport.fr

# ------------------------------------------------------------------
# Base de données MySQL
# ------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_USER=bluegenji
DB_PASSWORD=__REMPLACER__
DB_DATABASE=bluegenji_arena

# ------------------------------------------------------------------
# Google OAuth 2.0
# ------------------------------------------------------------------
# Récupérés dans Google Cloud Console > APIs & Services > Credentials.
# Le client OAuth (type "Web application") doit lister EXACTEMENT
# GOOGLE_REDIRECT_URI dans "Authorized redirect URIs".
GOOGLE_CLIENT_ID=__REMPLACER__.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=__REMPLACER__

# URI de callback OAuth. Doit pointer vers le domaine public (APP_URL)
# et être déclarée à l'identique côté Google Cloud Console.
GOOGLE_REDIRECT_URI=https://bluegenji-esport.fr/api/auth/google/callback

# ------------------------------------------------------------------
# Connexion OAuth Discord
# ------------------------------------------------------------------
# Portail : https://discord.com/developers/applications > votre application.
# Par défaut, la connexion réutilise l'application du bot (DISCORD_BOT_CLIENT_ID,
# plus bas) : un seul écran de consentement au nom de BlueGenji, une seule
# application à surveiller. Renseigner DISCORD_CLIENT_ID uniquement pour en
# séparer une seconde.
#
# Dans « OAuth2 > Redirects », déclarer EXACTEMENT :
#   <APP_URL>/api/auth/discord/callback
# Aucun scope à cocher côté portail : la portée demandée est `identify`, et elle
# est écrite dans le code (lib/server/discord-oauth.ts).
# DISCORD_CLIENT_ID=__REMPLACER__
DISCORD_CLIENT_SECRET=__REMPLACER__
# URI de rappel. Facultative : déduite d'APP_URL si absente.
# DISCORD_REDIRECT_URI=https://exemple.fr/api/auth/discord/callback

# ------------------------------------------------------------------
# Connexion OAuth Blizzard (Battle.net)
# ------------------------------------------------------------------
# Portail : https://develop.battle.net/access/clients > Create Client.
# Dans « Redirect URLs », déclarer EXACTEMENT :
#   <APP_URL>/api/auth/blizzard/callback
# La portée demandée est `openid` : l'identifiant du compte et le BattleTag,
# rien d'autre (aucune adresse e-mail n'est servie par Battle.net).
BLIZZARD_CLIENT_ID=__REMPLACER__
BLIZZARD_CLIENT_SECRET=__REMPLACER__
# BLIZZARD_REDIRECT_URI=https://exemple.fr/api/auth/blizzard/callback
# Région OAuth. `oauth.battle.net` sert les quatre régions occidentales ; seule
# la Chine a sa propre infrastructure, qui ne partage ni comptes ni jetons.
# Toute valeur autre que « cn » retombe sur l'origine mondiale.
# BLIZZARD_REGION=cn

# ------------------------------------------------------------------
# Intégration bot Discord (optionnel)
# ------------------------------------------------------------------
# URL interne du bot (localhost si même hôte, IP/DNS privé sinon).
BOT_INTERNAL_URL=http://127.0.0.1:4400
# Doit correspondre à INTERNAL_API_TOKEN du bot.
BOT_INTERNAL_TOKEN=__REMPLACER__

# ------------------------------------------------------------------
# Fréquentation du site (recommandé)
# ------------------------------------------------------------------
# Sel des empreintes de visiteur (SHA-256). Aucune IP n'est stockée : seule
# l'empreinte l'est. Sans ce sel, la valeur de repli est BOT_INTERNAL_TOKEN,
# et une empreinte redevient théoriquement rejouable depuis une IP connue.
VISIT_HASH_SALT=__REMPLACER__
# Nombre de proxys de confiance devant l'application (nginx seul = 1, CDN +
# nginx = 2). Sert à retenir la bonne entrée de X-Forwarded-For : on compte
# depuis la droite, la partie gauche de l'en-tête étant falsifiable par le
# visiteur. Une valeur trop basse regrouperait tous les visiteurs sous l'IP du
# relais le plus proche.
TRUSTED_PROXY_HOPS=1

# ------------------------------------------------------------------
# Le proxy pose-t-il `X-Real-IP` *sans* poser `X-Forwarded-For` ? (optionnel)
# ------------------------------------------------------------------
# `false` par défaut, et c'est le bon réglage pour nginx tel qu'il est
# configuré ici — il pose `X-Forwarded-For`, que l'app lit déjà.
# Ne passer à `true` que sur une installation dont le proxy ne pose que
# `X-Real-IP` : sans relais de confiance devant, cet en-tête est forgeable
# par l'appelant, qui obtiendrait un seau de plafonnement neuf à chaque
# requête. Voir `lib/server/api-guard.ts`.
# TRUSTED_PROXY_REAL_IP=false

# Contact RGPD (optionnel)
# ------------------------------------------------------------------
# Adresse affichée sur la page /rgpd. Si absente, utilise le fallback
# défini dans lib/shared/rgpd-policy.ts. Préférer une adresse dédiée
# (ex: rgpd@bluegenji-esport.fr) pour éviter l'exposition d'une adresse personnelle.
# RGPD_CONTACT_EMAIL=rgpd@bluegenji-esport.fr

# Identifiant de l'application Discord, utilisé pour générer le lien
# d'invitation OAuth2 du bot (pages /bot — BotHero, BotInviteCard).
# Sans cette variable, le bouton « Inviter le bot » reste inerte (href="#").
DISCORD_BOT_CLIENT_ID=__REMPLACER__
# Bitfield de permissions demandé à l'invitation (optionnel).
# Défaut : 1099511627776 (bot + applications.commands).
DISCORD_BOT_PERMISSIONS=1099511627776

# ------------------------------------------------------------------
# Bypass d'authentification dev — NE JAMAIS DÉFINIR EN PRODUCTION
# ------------------------------------------------------------------
# La fonction getCurrentUser() ignore cette variable quand NODE_ENV=production,
# mais on la laisse explicitement vide pour éviter toute confusion.
# DEV_AUTH_USER_ID=
