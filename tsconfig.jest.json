{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    // Pas de `moduleResolution` : « node » (node10) a été retiré en TypeScript
    // 7, et ts-jest transpile un fichier à la fois (les alias passent par le
    // `moduleNameMapper` de Jest) — le défaut associé à CommonJS suffit.
    // Next compile le JSX lui-même (`jsx: "preserve"`), ce que Node ne sait pas
    // exécuter : un test qui importe un composant doit le voir transpilé.
    "jsx": "react-jsx",
    "noEmit": true
  }
  // Pas d'`include` : ce fichier ne sert qu'aux **options de transpilation** de
  // ts-jest (`isolatedModules`, un fichier à la fois). Celui qu'il portait
  // (`tests`) était annulé par l'`exclude` hérité de `tsconfig.json` et ne
  // sélectionnait rien — un `tsc -p` dessus passait au vert sans lire un test.
  // La vérification des types des tests, c'est `tsconfig.typecheck.json`.
}
